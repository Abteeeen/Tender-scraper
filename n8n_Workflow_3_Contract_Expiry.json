    {
      "parameters": {
        "jsCode": "// Anything expiring in the 6-9 month sweet spot, not already flagged.\nconst today = new Date();\nreturn $input.all().filter((it) => {\n  const j = it.json;\n  if ((j.Alerted || '').toString().trim().toLowerCase() === 'yes') return false;\n  const end = j.EndDate ? new Date(j.EndDate) : null;\n  if (!end || isNaN(end)) return false;\n  const days = Math.round((end - today) / 86400000);\n  return days >= 150 && days <= 270;\n}).map((it) => ({ json: it.json }));"
      },
