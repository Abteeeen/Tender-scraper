      "id": "x0001-cexp-4a10-9a10-tenderradar",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// AusTender OCDS wants an ISO-8601 date interval. Look back 8 days so a\n// missed run is picked up next week rather than lost.\nconst end = new Date();\nconst start = new Date(end.getTime() - 8 * 86400000);\nconst iso = (d) => d.toISOString().slice(0, 10);\nreturn [{ json: { start: iso(start), end: iso(end), range: iso(start) + 'T00%3A00%3A00Z%2F' + iso(end) + 'T23%3A59%3A59Z' } }];"
      },
      "id": "x0002-cexp-4a10-9a10-tenderradar",
      "name": "Build Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        400
      ]
    },
    {
      "parameters": {
        "url": "=https://api.tenders.gov.au/ocds/findByDates/contractPublished/{{ $json.range }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
            },
            {
              "name": "Authorization",
              "value": "REPLACE_WITH_AUSTENDER_API_TOKEN"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "x0003-cexp-4a10-9a10-tenderradar",
      "name": "Fetch Contract Notices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        60,
        400
      ],
      "onError": "continueRegularOutput",
      "notes": "AusTender OCDS API requires an access token — request one from tenders.gov.au and put it in the Authorization header (ideally via an n8n credential, not inline)."
    },
    {
      "parameters": {
        "jsCode": "// Flatten OCDS release packages into one item per contract.\nconst out = [];\nfor (const it of $input.all()) {\n  const pkg = it.json || {};\n  const releases = pkg.releases || pkg.data?.releases || [];\n  for (const r of releases) {\n    const awards = r.awards || [];\n    const contracts = r.contracts || [];\n    const buyer = r.buyer?.name || r.parties?.find((p) => (p.roles || []).includes('buyer'))?.name || '';\n    const list = contracts.length ? contracts : awards;\n    for (const c of list) {\n      const supplier = (c.suppliers && c.suppliers[0]?.name)\n        || (awards[0]?.suppliers && awards[0].suppliers[0]?.name) || '';\n      const period = c.period || awards[0]?.period || {};\n      out.push({ json: {\n        cn_id: c.id || r.ocid || '',\n        title: c.title || r.tender?.title || '',\n        description: c.description || r.tender?.description || '',\n        buyer,\n        supplier,\n        value: c.value?.amount || awards[0]?.value?.amount || '',\n        currency: c.value?.currency || 'AUD',\n        start_date: (period.startDate || '').slice(0, 10),\n        end_date: (period.endDate || '').slice(0, 10),\n        published: (r.date || '').slice(0, 10),\n        category: r.tender?.mainProcurementCategory || '',\n        blob: ((c.title || '') + ' ' + (c.description || '') + ' ' + (r.tender?.title || '') + ' ' + buyer).toLowerCase()\n      }});\n    }\n  }\n}\nreturn out;"
      },
      "id": "x0004-cexp-4a10-9a10-tenderradar",
      "name": "Extract Contracts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep only cleaning / security service contracts in or serviceable from SEQ.\nconst SERVICE = /\\b(cleaning|cleaner|janitor|janitorial|housekeeping|custodial|security guard|security service|security officer|guarding|manned guarding|static guard|patrol|concierge|cctv|surveillance|access control|alarm monitoring)\\b/i;\nconst NEG = /\\b(cyber ?security|information security|it security|data security|biosecurity|food security|national security)\\b/i;\nconst SEQ = /\\b(brisbane|gold coast|logan|ipswich|redland|moreton|caboolture|beenleigh|springfield|cleveland|wynnum|chermside|carrara|southport|robina|nerang|coomera|strathpine|queensland|qld)\\b/i;\n\nreturn $input.all().filter((it) => {\n  const b = it.json.blob || '';\n  if (NEG.test(b)) return false;\n  if (!SERVICE.test(b)) return false;\n  return SEQ.test(b);\n});"
      },
      "id": "x0005-cexp-4a10-9a10-tenderradar",
      "name": "Filter Cleaning & Security",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Work out when each contract runs out and how much warning is left.\nconst today = new Date();\nconst ts = new Date().toLocaleString('en-AU', { timeZone: 'Australia/Brisbane' });\nreturn $input.all().map((it) => {\n  const j = it.json;\n  const end = j.end_date ? new Date(j.end_date) : null;\n  let daysLeft = '', monthsLeft = '', window = '';\n  if (end && !isNaN(end)) {\n    daysLeft = Math.round((end - today) / 86400000);\n    monthsLeft = Math.round(daysLeft / 30.4);\n    if (daysLeft < 0) window = 'Expired';\n    else if (daysLeft <= 270 && daysLeft >= 150) window = 'ACT NOW (6-9 months out)';\n    else if (daysLeft < 150) window = 'Late — tender likely already out';\n    else window = 'Watch';\n  }\n  return { json: {\n    Logged: ts,\n    ContractID: j.cn_id,\n    Title: j.title,\n    Buyer: j.buyer,\n    Incumbent: j.supplier,\n    Value: j.value,\n    StartDate: j.start_date,\n    EndDate: j.end_date,\n    DaysToExpiry: daysLeft,\n    MonthsToExpiry: monthsLeft,\n    Window: window,\n    Published: j.published,\n    Notes: (j.description || '').toString().slice(0, 400)\n  }};\n});"
      },
