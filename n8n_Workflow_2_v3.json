      "parameters": {
        "jsCode": "// Combine extracted texts from PDF + XLSX files (JSON only, no binary)\nconst items = $input.all();\nconst meta = $('Extract Drive File ID').first().json;\nlet combined = '';\nfor (const item of items) {\n  const j = item.json;\n  if (typeof j.text === 'string' && j.text.length > 0) {\n    combined += '\\n\\n===== PDF SUMMARY =====\\n' + j.text;\n  } else {\n    // XLSX data comes as JSON rows - stringify it\n    const keys = Object.keys(j).filter(k => k !== 'text');\n    if (keys.length > 0) {\n      combined += '\\n\\n===== SPREADSHEET DATA =====\\n' + JSON.stringify(j, null, 1);\n    }\n  }\n}\nreturn [{ json: {\n  RowID: meta.RowID || '',\n  title: meta.Title || '',\n  link: meta.Link || '',\n  doc_text: combined.replace(/[\\t ]+/g, ' ').slice(0, 250000)\n} }];"
      },
