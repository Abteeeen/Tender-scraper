{
  "name": "Tender Scraping Workflow v2 (Multi-Site + Bypasses)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "e1f18838-89f5-4428-98e3-0c460d37e4d8",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://www.tenders.gov.au/rss/atm",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
            },
            {
              "name": "Accept",
              "value": "application/rss+xml, application/xml, text/xml"
            }
          ]
        },
        "options": {}
      },
      "id": "6d3a84e6-d922-491c-b715-db2c219602a6",
      "name": "Fetch AusTender RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [200, -100]
    },
    {
      "parameters": {
        "url": "https://www.tenders.nsw.gov.au/?event=public.rss.list",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
            }
          ]
        },
        "options": {}
      },
      "id": "1d3a84e6-d922-491c-b715-db2c219602a6",
      "name": "Fetch NSW eTendering",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [200, 100]
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "2d3a84e6-d922-491c-b715-db2c219602a6",
      "name": "Merge Feeds",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [450, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.title }}",
              "operation": "contains",
              "value2": "security"
            },
            {
              "value1": "={{ $json.title }}",
              "operation": "contains",
              "value2": "cleaning"
            },
            {
              "value1": "={{ $json.title }}",
              "operation": "contains",
              "value2": "facility"
            }
          ]
        },
        "combineConditions": "OR"
      },
      "id": "a98a0b5f-5cfd-4a11-b1e1-1c322b7c6c74",
      "name": "Filter Security/Cleaning",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [650, 0]
    },
    {
      "parameters": {
        "url": "={{ $json.link }}",
        "responseFormat": "file",
        "options": {}
      },
      "id": "f5f543c7-1d8f-43b6-a577-ffc297c11f77",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 0]
    },
    {
      "parameters": {
        "operation": "extract",
        "binaryPropertyName": "data"
      },
      "id": "d0e12d1b-8519-4cb5-b467-331139dc7b18",
      "name": "Extract from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [1050, 0]
    },
    {
      "parameters": {
        "prompt": "=Read the following tender text and extract the details.\n\nTender Text: {{ $json.text }}\n\nOutput exactly this format:\n**Summary:** [1 paragraph summary of the job]\n**Budget/Value:** [Extracted budget or 'Not Listed']\n**Deadlines:** [Submission closing date and time]\n**Go/No-Go Red Flags:** [List any mandatory ISO certifications, union requirements, or minimum insurance thresholds. If none, write 'None found'.]"
      },
      "id": "3bd427a1-5ab9-42b4-82a8-0f5a7d65b1cd",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "position": [1250, 0]
    },
    {
      "parameters": {
        "model": "gpt-4o"
      },
      "id": "18f91db7-8b43-4cb5-9c55-320d757d5e46",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Title|title",
              "title": "={{ $node[\"Filter Security/Cleaning\"].json.title }}"
            },
            {
              "key": "Link|url",
              "url": "={{ $node[\"Filter Security/Cleaning\"].json.link }}"
            },
            {
              "key": "AI Summary|rich_text",
              "textContent": "={{ $json.text }}"
            }
          ]
        }
      },
      "id": "93b2a5eb-fc15-46f3-a7bb-ec0364d2629b",
      "name": "Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [1450, 0]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch AusTender RSS",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch NSW eTendering",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch AusTender RSS": {
      "main": [
        [
          {
            "node": "Merge Feeds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch NSW eTendering": {
      "main": [
        [
          {
            "node": "Merge Feeds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Feeds": {
      "main": [
        [
          {
            "node": "Filter Security/Cleaning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Security/Cleaning": {
      "main": [
        [
          {
            "node": "Download PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download PDF": {
      "main": [
        [
          {
            "node": "Extract from File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract from File": {
      "main": [
        [
          {
            "node": "Basic LLM Chain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Basic LLM Chain": {
      "main": [
        [
          {
            "node": "Notion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Basic LLM Chain",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
